# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Netlify personal access token
# Generate at: app.netlify.com → User Settings → Applications → Personal access tokens
NETLIFY_TOKEN=your_personal_access_token_here

# Netlify site ID for oklahomahomesteadrendezvous
# Find at: app.netlify.com → Site → Site configuration → Site ID
NETLIFY_SITE_ID=your_site_id_here
